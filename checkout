/**
 * Core E-commerce Checkout Handler
 * Manages cart state, tax calculations, and external payment links.
 */

// Global state for user checkout
const CheckoutState = {
    cartItems: [
        { id: "PROD001", name: "Premium License", price: 49.99, quantity: 1 }
    ],
    salesTaxRate: 0.08, // 8% Sales Tax
    discountAmount: 0.00
};

/**
 * Calculates current subtotal, tax, and order totals
 */
function calculateOrderTotals() {
    const subtotal = CheckoutState.cartItems.reduce((acc, item) => {
        return acc + (item.price * item.quantity);
    }, 0);

    const taxableAmount = Math.max(0, subtotal - CheckoutState.discountAmount);
    const tax = taxableAmount * CheckoutState.salesTaxRate;
    const finalTotal = taxableAmount + tax;

    return {
        subtotal: subtotal.toFixed(2),
        tax: tax.toFixed(2),
        total: finalTotal.toFixed(2)
    };
}

/**
 * Updates the web page visual interface dynamically
 */
function renderCheckoutInterface() {
    const totals = calculateOrderTotals();
    
    // Update elements if they exist on the DOM
    const subtotalEl = document.getElementById("subtotal-display");
    const taxEl = document.getElementById("tax-display");
    const totalEl = document.getElementById("total-display");

    if (subtotalEl) subtotalEl.innerText = `$${totals.subtotal}`;
    if (taxEl) taxEl.innerText = `$${totals.tax}`;
    if (totalEl) totalEl.innerText = `$${totals.total}`;
}

/**
 * Handles the submission event and payment gateway routing
 */
function processSecureCheckout(event) {
    event.preventDefault();
    
    const totals = calculateOrderTotals();
    const customerEmail = document.getElementById("customer-email")?.value || "Guest";

    console.log(`Initializing checkout session for ${customerEmail}...`);
    console.log(`Amount due: $${totals.total}`);

    // If using a pre-configured Payment Provider link or direct payment portal:
    // Change this to your live payment gateway URL configuration
    const stripePaymentGatewayUrl = `https://stripe.com{encodeURIComponent(customerEmail)}`;
    
    // Redirect user securely to complete checkout
    window.location.href = stripePaymentGatewayUrl;
}

// Ensure the page updates elements when loaded
document.addEventListener("DOMContentLoaded", () => {
    renderCheckoutInterface();
    
    const form = document.getElementById("payment-form");
    if (form) {
        form.addEventListener("submit", processSecureCheckout);
    }
});
